# CodeXplus Server Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Connection String (replace with your local or cloud PostgreSQL database)
# Example: postgresql://USER:PASSWORD@localhost:5432/codexplus?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codexplus?schema=public"

# JWT Secret for Admin Authentication
JWT_SECRET="codexplus_super_secret_jwt_key_2026_change_in_production"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"
